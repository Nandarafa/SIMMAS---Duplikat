# ============================================================
# SIMMAS - Environment Variables Template
# ============================================================
# 
# File ini adalah TEMPLATE untuk .env.local
# File ini AMAN di-commit ke git (tidak ada secret keys)
# 
# CARA SETUP:
# 1. Copy file ini jadi .env.local
#    Windows: copy .env.example .env.local
#    Mac/Linux: cp .env.example .env.local
# 2. Isi nilai sebenarnya di .env.local
# 3. Restart development server
# 
# ============================================================

# ------------------------------------------------------------
# SUPABASE CONFIGURATION (REQUIRED)
# ------------------------------------------------------------
# Dapatkan dari: https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ------------------------------------------------------------
# OPTIONAL: ADDITIONAL API KEYS
# ------------------------------------------------------------

# Google Maps API (untuk lokasi DUDI)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Email Service (untuk notifikasi email)
# EMAIL_SERVICE_API_KEY=your_email_service_api_key_here
# EMAIL_FROM=noreply@simmas.sch.id

# SMS Gateway (untuk notifikasi SMS)
# SMS_GATEWAY_API_KEY=your_sms_gateway_api_key_here

# File Upload Service (jika tidak pakai Supabase Storage)
# CLOUDINARY_CLOUD_NAME=your_cloudinary_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret
