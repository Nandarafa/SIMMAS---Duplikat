# ============================================================
# SIMMAS - Environment Variables
# Salin file ini menjadi .env.local lalu isi nilainya
# ============================================================

# Supabase Project URL & Anon Key
# Dapatkan dari: https://app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# CATATAN SETUP SUPABASE
# ============================================================
# 1. Buat project baru di https://app.supabase.com
# 2. Jalankan SQL di supabase/schema.sql via SQL Editor
# 3. Isi variabel di atas dengan nilai dari Settings > API
# 4. Salin file ini: cp .env.example .env.local
# ============================================================
